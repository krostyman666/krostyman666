# Database
DATABASE_URL=postgresql://user:password@localhost:5432/inmobiliaria
DB_HOST=localhost
DB_PORT=5432
DB_NAME=inmobiliaria
DB_USER=immobiliary_user
DB_PASSWORD=change_me_in_production

# Backend
NODE_ENV=development
BACKEND_PORT=3001
API_URL=http://localhost:3001

# Frontend
FRONTEND_PORT=3000
REACT_APP_API_URL=http://localhost:3001

# JWT
JWT_SECRET=your_jwt_secret_key_change_in_production
JWT_EXPIRE=7d

# Docusign (Firma Digital)
DOCUSIGN_CLIENT_ID=your_docusign_client_id
DOCUSIGN_CLIENT_SECRET=your_docusign_client_secret
DOCUSIGN_ACCOUNT_ID=your_docusign_account_id
DOCUSIGN_BASE_URL=https://demo.docusign.net

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# SII Integration (Servicios de Impuestos Internos)
SII_API_URL=https://www.sii.cl
SII_CONSUMER_KEY=your_sii_key
SII_CONSUMER_SECRET=your_sii_secret

# Stripe (Pagos)
STRIPE_PUBLIC_KEY=your_stripe_public_key
STRIPE_SECRET_KEY=your_stripe_secret_key

# AWS (S3 para documentos)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_aws_key
AWS_SECRET_ACCESS_KEY=your_aws_secret
AWS_S3_BUCKET=inmobiliaria-docs

# Redis (Cache)
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=debug
