# --- Base de datos ---
DATABASE_URL=postgresql://trato:trato_local@localhost:5432/trato
POSTGRES_USER=trato
POSTGRES_PASSWORD=trato_local
POSTGRES_DB=trato

# --- Backend ---
NODE_ENV=development
BACKEND_PORT=3001
FRONTEND_URL=http://localhost:3000

# Generar con: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRE=7d

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:3001

# El mapa de resultados (/propiedades) funciona sin esto: usa Leaflet y
# OpenStreetMap, gratis y sin llave. Si se contrata Google Maps Platform,
# poner la llave acá activa Google en el mismo componente sin tocar código.
# El mapa de una propiedad individual (MapaPropiedad) sigue siempre con el
# iframe de OpenStreetMap -- un solo punto no necesita mapa interactivo.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Firma electronica ---
# "simple" firma dentro de la plataforma con firma electronica simple (Ley
# 19.799), valida para una promesa aunque con menor valor probatorio. Para subir
# ese valor hay que contratar un prestador de firma avanzada: Docusign por si
# solo NO entrega FEA reconocida en Chile. La compraventa definitiva no se firma
# electronicamente en ningun caso: va por escritura publica ante notario.
FIRMA_PROVEEDOR=simple
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ACCOUNT_ID=
DOCUSIGN_BASE_URL=https://demo.docusign.net

# --- Pagos ---
# Flow es el destino: agregador, una integracion da Webpay, transferencia y
# Servipag sin certificarse con Transbank, y deja la transferencia en 0,99%.
# Stripe quedo descartado: no admite registro de empresas chilenas y cobra 3,6%.
FLOW_API_KEY=
FLOW_SECRET_KEY=
FLOW_BASE_URL=https://sandbox.flow.cl/api

# Cuenta para transferencias mientras el cobro se concilia a mano.
# Sin estos datos la plataforma no ofrece el medio.
COBRO_BANCO=
COBRO_TIPO_CUENTA=
COBRO_NUMERO_CUENTA=
COBRO_TITULAR=
COBRO_RUT=
COBRO_EMAIL=

# --- SII: avalúo fiscal por rol ---
# El SII no publica API propia. "ninguno" (default) deja el informe con "fuente
# por conectar" en vez de inventar un avalúo. "baseapi" activa la consulta real
# vía un proveedor de terceros que sí ofrece el catastro SII por REST -- hay que
# contratarlo y poner la llave abajo.
# Tesorería (contribuciones) no tiene equivalente: exige ClaveÚnica o Clave
# Tributaria del propio contribuyente, así que no hay integración posible; el
# certificado se sube al expediente como cualquier otro documento.
SII_PROVEEDOR=ninguno
BASEAPI_URL=https://api.baseapi.cl
BASEAPI_KEY=

# --- Integraciones externas (n8n) ---
# Llave fija que usan flujos externos para empujar datos a /api/v1/integraciones/*
# (hoy: avaluo fiscal y contribuciones consultados por rol, via n8n). No es un
# JWT de usuario: es un sistema llamando, no una persona de la operacion.
# Generar con: openssl rand -hex 32. Vacia por defecto -- sin ella, la ruta
# rechaza todo.
INTEGRACION_API_KEY=

# --- UF (indicador diario) ---
UF_API_URL=https://mindicador.cl/api/uf

# --- Informe del inmueble ---
# Placeholder. Insumo conocido: $13.500 de la carpeta de titulos del
# Conservador de Santiago (varia por territorio). El margen es decision
# comercial pendiente. Se congela en cada informe al momento de pedirlo.
PRECIO_INFORME_TITULOS_CLP=49000

# --- Almacenamiento de documentos ---
# "local" escribe al disco del backend y sirve para desarrollo. En produccion
# hay que pasar a "s3": el disco del contenedor es efimero y no se comparte
# entre instancias. Los archivos nunca son publicos; se sirven por endpoint
# autenticado que exige acceso al expediente.
ALMACENAMIENTO_DRIVER=local
ALMACENAMIENTO_DIR=
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET=trato-documentos

# --- Email ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
