{
  "cli": {
    "version": ">= 7.0.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "channel": "development",
      "env": {
        "ENVIRONMENT": "development"
      }
    },
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "ENVIRONMENT": "preview"
      },
      "ios": {
        "enterpriseProvisioning": "adhoc"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "channel": "production",
      "env": {
        "ENVIRONMENT": "production"
      },
      "ios": {
        "enterpriseProvisioning": "universal"
      }
    },
    "testing": {
      "distribution": "internal",
      "channel": "testing",
      "env": {
        "ENVIRONMENT": "testing",
        "DEBUG": "true"
      },
      "ios": {
        "enterpriseProvisioning": "adhoc",
        "simulator": false
      },
      "android": {
        "buildType": "apk",
        "gradleCommand": ":app:assembleDebug"
      }
    }
  },
  "submit": {
    "production": {
      "ios": true,
      "android": true
    }
  },
  "resourceClass": {
    "ios": "default",
    "android": "default"
  }
}
